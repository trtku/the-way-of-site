---
import { site } from '../config/site';
import { content } from '../lib/content';
---
<footer>
  <div class="shell">
    <div class="frow">
      <a class="fmark" href="/" aria-label={`${site.nameEn} トップページ`}>
        <span lang="en">{site.nameEn}</span><span class="arw" aria-hidden="true"></span>
      </a>
      <nav class="flinks" aria-label="関連リンク">
        <a href={site.links.instagram}>Instagram<span class="sr-only">（外部サイト）</span></a
        ><a href={site.links.note}>note<span class="sr-only">（外部サイト）</span></a
        ><a href="/exhibitions/">展示一覧</a>
      </nav>
    </div>
    <p class="fc">
      by <b>{site.team}</b><br />
      {site.partner} と連携して運営しています。{site.cadence}。<br />
      最終更新 <time datetime={content.fetchedAt}>{content.fetchedAt.slice(0, 10).replace(/-/g, '.')}</time>
    </p>
  </div>
</footer>
