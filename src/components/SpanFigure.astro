---
import type { Exhibition } from '../types';

interface Props {
  rows: Exhibition[];
  /** 基準日。ふつうはビルド日。 */
  today?: Date;
}
const { rows, today = new Date() } = Astro.props;

const DAY = 86400000;
const toD = (iso: string) => Date.parse(iso + 'T00:00:00+09:00');

/* 表示する窓は「今月の1日」から「いちばん遅い終了日」まで。
   展示が無い月でも崩れないよう、最低28日は確保する。 */
const y = today.getFullYear();
const m = today.getMonth();
const winStart = Date.parse(
  `${y}-${String(m + 1).padStart(2, '0')}-01T00:00:00+09:00`
);
const ends = rows.map((r) => toD(r.end!)).filter((n) => !Number.isNaN(n));
const winEnd = Math.max(winStart + 28 * DAY, ...(ends.length ? ends : [0]));
const span = Math.max(winEnd - winStart, DAY);

const pos = (t: number) => ((t - winStart) / span) * 100;
const clamp = (n: number) => Math.min(Math.max(n, 0), 100);

const bars = rows
  .filter((r) => r.start && r.end)
  .map((r) => {
    const s = toD(r.start!);
    const e = toD(r.end!);
    const left = clamp(pos(s));
    const right = clamp(pos(e));
    return {
      ...r,
      left,
      width: Math.max(right - left, 1.5),
      /* 窓の外へ続いているか（右端に ▸ を出す） */
      continues: e > winEnd,
      startsBefore: s < winStart
    };
  });

const todayPos = pos(today.getTime());
const showToday = todayPos >= 0 && todayPos <= 100;

/* 目盛り（7日ごと） */
const ticks: { left: number; label: string }[] = [];
for (let t = winStart; t <= winEnd; t += 7 * DAY) {
  const d = new Date(t + 9 * 3600000);
  ticks.push({ left: pos(t), label: String(d.getUTCDate()).padStart(2, '0') });
}

const ym = `${y}-${String(m + 1).padStart(2, '0')}`;
const jp = (iso: string) => {
  const [yy, mm, dd] = iso.split('-');
  return `${yy}年${Number(mm)}月${Number(dd)}日`;
};
const todayJp = jp(today.toISOString().slice(0, 10));
---
{bars.length > 0 && (
<figure class="span">
  <figcaption class="span-h">
    <span class="lb">会期の重なり</span>
    <span class="rl" aria-hidden="true"></span>
    <span class="mn"><time datetime={ym}>{ym.replace('-', '.')}</time></span>
  </figcaption>

  {/* 図は目で見るためのもの。同じ内容を表で用意して、読み上げと機械可読の両方に備える */}
  <div class="sr-only">
    <table>
      <caption>{`${y}年${m + 1}月時点の会期一覧`}</caption>
      <thead>
        <tr><th scope="col">名称</th><th scope="col">開始</th><th scope="col">終了</th></tr>
      </thead>
      <tbody>
        {bars.map((b) => (
          <tr>
            <th scope="row">{b.title}</th>
            <td>{jp(b.start!)}</td>
            <td>{jp(b.end!)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>{`本日は${todayJp}です。`}</p>
  </div>

  {bars.map((b, i) => (
    <div class="srow" aria-hidden="true">
      <span class="nm">{b.title}</span>
      <div class="track">
        <div
          class:list={['sp-bar', i === 0 ? 'solid' : 'hatch']}
          style={`left:${b.left}%;width:${b.width}%`}
        >
          {b.continues && <span class="cont">▸</span>}
        </div>
        {showToday && <div class="today" style={`left:${todayPos}%`}></div>}
      </div>
    </div>
  ))}

  <div class="axis" aria-hidden="true">
    <span></span>
    <div class="t">
      {ticks.map((t) => <span style={`left:${t.left}%`}>{t.label}</span>)}
    </div>
  </div>
</figure>
)}
